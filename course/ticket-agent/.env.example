# 复制为 .env 后修改。.env 已在 .gitignore 中，不要提交真实密钥。
# mock = 离线假模型（无需 API key，用于学习和自动化测试）
# openai = 任何兼容 OpenAI Chat Completions 的服务（DeepSeek、通义千问、OpenAI 等）
MODEL_PROVIDER=mock

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 每百万 token 价格（元），仅用于估算费用；以服务商当前价格为准
LLM_PRICE_INPUT=2
LLM_PRICE_OUTPUT=8

PORT=8787
# 默认 ./data/agent.db。Docker 镜像里已设置为挂载卷 /data/agent.db，不要在这里覆盖
# DATABASE_PATH=./data/agent.db
# 允许发起写请求的前端来源，防止跨站请求伪造
ALLOWED_ORIGIN=http://localhost:5173
# 演示登录（选用户名即可登录）。开发环境默认开启；NODE_ENV=production 时默认关闭并拒绝启动
# DEMO_LOGIN=true
