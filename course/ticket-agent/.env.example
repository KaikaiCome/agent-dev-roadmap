# 复制为 .env 后修改。.env 已在 .gitignore 中，不要提交真实密钥。
# mock = 离线假模型（无需 API key，用于学习和自动化测试）
# openai = 任何兼容 OpenAI Chat Completions 的服务（DeepSeek、通义千问、OpenAI 等）
MODEL_PROVIDER=mock

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 每百万 token 价格（元），仅用于估算费用；以服务商当前价格为准
LLM_PRICE_INPUT=2
LLM_PRICE_OUTPUT=8

PORT=8787
# 默认 ./data/agent.db。Docker 镜像里已设置为挂载卷 /data/agent.db，不要在这里覆盖
# DATABASE_PATH=./data/agent.db
# 允许发起写请求的前端来源，防止跨站请求伪造
ALLOWED_ORIGIN=http://localhost:5173
# 演示登录（选用户名即可登录）。开发环境默认开启；NODE_ENV=production 时默认关闭并拒绝启动
# DEMO_LOGIN=true

# 检索方式（第 18 章）：keyword = 关键词检索（默认）；hybrid = BM25 + 向量混合检索
RETRIEVAL=keyword
# 向量模型：mock = 离线替身（只用于学习流程，分数不代表真实效果）；openai = 兼容 /embeddings 的服务
EMBEDDING_PROVIDER=mock
# 不设置时沿用 LLM_BASE_URL 和 LLM_API_KEY。DeepSeek 没有 embedding 接口，需要另选服务商
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# 向量相关性门槛，换模型后用 npm run bench:hybrid 重新校准
# EMBEDDING_MIN_SIMILARITY=0.5

# 子 Agent（第 19 章）：on = 检索交给只读的调研子 Agent（更多 token 和延迟）；off = 主 Agent 直接检索（默认）
SUBAGENT=off
# 长期记忆（第 19 章）：on = 员工说“记住：…”并确认后，之后的对话会参考；off = 不记忆（默认）
MEMORY=off
# 护栏（第 21 章）：on = 输入检查、工具调用策略、工具结果筛查、输出过滤（开启后回答先检查再整段推送，不再逐字流式）；off = 不启用（默认）
GUARDRAILS=off

# 追踪（第 22 章）：设置收集端地址后才开启，导出 OTLP/HTTP JSON 到 <地址>/v1/traces；不设置则完全关闭
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ticket-agent
# 采样比例 0~1（按 traceId 的头部采样），默认 1
# OTEL_TRACES_SAMPLER_ARG=1
# 是否在 span 上记录提示词、回答和工具参数：默认 NO_CONTENT（不记录）；SPAN_ONLY 才记录，注意隐私
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_CONTENT=NO_CONTENT

# 分布式运行（第 23 章）：inline = API 进程直接执行 run（默认）；queue = API 只入队，由 npm run worker 进程执行
RUN_MODE=inline
# 租约时长（毫秒），worker 每 1/3 租约续约一次；重试次数上限，用完进入死信
# QUEUE_LEASE_MS=30000
# QUEUE_MAX_ATTEMPTS=5
# 每个租户同时执行的 run 上限；排队上限（超过时 API 返回 429）
# TENANT_MAX_INFLIGHT=4
# TENANT_MAX_QUEUED=100
# 每个 worker 进程同时执行的 run 数
# WORKER_CONCURRENCY=4
# 工单通知的 webhook 地址（带 Idempotency-Key 头）；不设置则投递到本地 <数据库>-inbox.db
# WEBHOOK_URL=http://localhost:9000/hooks/ticket

# 真实模型下的可靠性（第 24 章，只影响 npm run eval:k）
# 每条用例重复次数
# K=5
# 随机扰动 mock：v1 / v2 / off（默认 off），SEED 是随机种子
# STOCHASTIC=off
# SEED=1
# 工具参数先按 schema 校验，不合法就让模型当场重试：on / off
# VALIDATE_TOOLS=off
# 录制模型调用到 JSON（会脱敏密钥）；回放录音，不访问模型，未命中即失败
# LLM_RECORD=examples/fixtures/replay/real.json
# LLM_REPLAY=examples/fixtures/replay/eval-k-v1-seed1.json
# 保存本次结果快照；与基线快照比较、检测漂移
# EVAL_SNAPSHOT=data/eval-snapshot.json
# EVAL_BASELINE=examples/fixtures/drift/baseline-v1.json
