{
  "name": "ticket-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "hello": "node --env-file-if-exists=.env examples/01-hello-model.ts",
    "mini": "node --env-file-if-exists=.env examples/02-mini-agent.ts",
    "bench": "node examples/03-retrieval-bench.ts",
    "bench:hybrid": "node --env-file-if-exists=.env examples/05-hybrid-bench.ts",
    "bench:memory": "node examples/06-memory-bench.ts",
    "coding": "node examples/07-coding-agent.ts",
    "slo": "node examples/08-slo.ts",
    "redteam": "node examples/09-redteam.ts",
    "train:data": "node examples/10-training-data.ts",
    "train:compare": "node examples/11-model-compare.ts",
    "replay": "node --env-file-if-exists=.env examples/04-replay-run.ts",
    "chat": "node --env-file-if-exists=.env src/cli.ts",
    "server": "node --env-file-if-exists=.env src/main.ts",
    "eval": "node --env-file-if-exists=.env src/eval/run.ts",
    "eval:k": "node --env-file-if-exists=.env src/eval/run-k.ts",
    "structured": "node examples/12-structured.ts",
    "worker": "node --env-file-if-exists=.env src/worker.ts",
    "chaos": "node examples/13-chaos.ts",
    "paradigms": "node examples/14-paradigms.ts",
    "test": "node --test \"test/*.test.ts\"",
    "verify": "node src/verify/run.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
